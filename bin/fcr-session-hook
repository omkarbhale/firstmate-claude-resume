#!/usr/bin/env bash
# fcr-session-hook - firstmate-claude-resume's Claude Code SessionStart hook.
# It records the exact session id of every firstmate Claude session, next to
# that task's firstmate record, so `fcr resume` can bring it back after a
# reboot or a Herdr restart.
#
# Installed by install.sh as ONE SessionStart entry in <config dir>/settings.json.
# Claude runs it on every startup, resume, clear and compact event, with the
# event JSON (session_id, cwd, source, transcript_path) on stdin.
#
# Where it writes:
#   - FM_TASK_INBOX=<home>/state/<task-id>.inbox set: <home>/state/<task-id>.claude-session
#   - otherwise, cwd is a firstmate home root (bin/fm-lock.sh and bin/fm-spawn.sh
#     present): <home>/state/.primary-claude-session
#   - otherwise: nothing (not a firstmate session).
# The record is one JSON object (format version 1) written atomically (temp
# file plus rename), so it always names the current session id.
#
# The recorded cwd is where `fcr resume` relaunches the session, and Claude only
# loads a home's .claude/ config (hooks, commands, skills) from the home root. A
# session can report a subfolder of its home (say, a project clone it is reading),
# so when the reported cwd sits inside a firstmate home it is recorded as that
# home's root instead (the nearest ancestor with bin/fm-lock.sh and bin/fm-spawn.sh).
# A cwd outside any home, such as a task worktree, is recorded as reported.
#
# What it records: the session id, cwd, source event, transcript path, the
# Herdr session/workspace/tab/pane from the HERDR_* variables, a capture time,
# the exact launch argv of the owning `claude` process (read from /proc by
# walking this hook's ancestry, never reconstructed), that process's whole
# launch environment except two kinds of names, and previous_sessions: the last
# 10 ids the record named before, newest first. The two kinds of names:
#   - credential-like names (FCR_ENV_DENY below, plus the patterns in the
#     optional extra file, see fcr_env_deny_extra): never written, so a secret
#     never reaches a record. Their names, never their values, go in
#     env_withheld, so `fcr resume` leaves the pane shell's own copy alone.
#   - names that describe the process or pane, not the launch (FCR_ENV_SKIP):
#     the resumed pane supplies its own.
# env_scope "full" marks a record that holds the whole environment, as opposed
# to the older allowlisted one.
#
# It skips `--print` sessions and nested Claude processes, so a child can never
# overwrite its parent task's record. A nested claude is one whose own launch
# environment has CLAUDECODE=1, which Claude Code sets for every process it
# starts (such as a `claude -p` a worker runs). Firstmate's Herdr backend unsets
# CLAUDECODE when it starts a Herdr server, so worker panes never inherit it;
# the process tree is not used, because a Herdr server started from inside a
# Claude session puts every pane under that session.
#
# It must never fail or slow a session: no network, no output, exit 0 always.
# Set FCR_HOOK_DEBUG=<file> to append a one-line reason when it records or skips.
set -u

# Names whose values are credentials, matched case-insensitively against the
# variable NAME (never the value). To add more without editing this file, list
# extended regular expressions, one per line, in the file named by
# FCR_ENV_DENY_FILE (default ${XDG_CONFIG_HOME:-~/.config}/fcr/env-deny).
FCR_ENV_DENY='(TOKEN|SECRET|PASSWORD|PASSWD|PASSPHRASE|API_?KEY|ACCESS_?KEY|PRIVATE_?KEY|SIGNING_?KEY|CREDENTIAL|BEARER|COOKIE|(^|_)AUTH(ORIZATION)?(_|$)|(^|_)KEY$|(^|_)PAT$|(^|_)PW$|(^|_)(DSN|(DATABASE|DB|REDIS|MONGO(DB)?|POSTGRES(QL)?|MYSQL|AMQP)_URL|CONNECTION_STRING)$)'
# Names that belong to the process or the pane, not to the launch. Keep this in
# step with the names `fcr resume` always leaves alone (fcr_write_launcher).
FCR_ENV_SKIP='^(HERDR_[A-Za-z0-9_]*|PWD|OLDPWD|SHLVL|_|SHELLOPTS|BASHOPTS|CLAUDECODE|CLAUDE_CODE_(SESSION_ID|MESSAGING_[A-Za-z0-9_]*|CHILD_SESSION|ENTRYPOINT|EXECPATH|SSE_PORT))$'

fcr_hook_debug() {
  [ -n "${FCR_HOOK_DEBUG:-}" ] || return 0
  printf '%s fcr-session-hook: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$FCR_HOOK_DEBUG" 2>/dev/null || true
}

# fcr_hook_deny_pattern: the credential name pattern, the built-in one plus
# every line of the optional extra file (blank lines and # comments ignored).
fcr_hook_deny_pattern() {
  local file=${FCR_ENV_DENY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/fcr/env-deny} line pat=$FCR_ENV_DENY
  if [ -f "$file" ] && [ -r "$file" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      line=${line%$'\r'}
      [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
      pat+="|($line)"
    done <"$file"
  fi
  printf '%s' "$pat"
}

# fcr_hook_env_json <pid> <deny-pattern>: {env: {...}, withheld: [names]}
fcr_hook_env_json() {
  jq -Rs --arg skip "$FCR_ENV_SKIP" --arg deny "$2" '
    split("\u0000")
    | map(select(test("\\A[A-Za-z_][A-Za-z0-9_]*=")) | (index("=") as $i | {key: .[:$i], value: .[$i + 1:]}))
    | map(select(.key | test($skip) | not))
    | { env: (map(select((.key | test($deny; "i")) | not)) | from_entries),
        withheld: (map(select(.key | test($deny; "i")) | .key) | unique) }
  ' <"/proc/$1/environ" 2>/dev/null
}

# fcr_hook_is_claude <pid>: the process is a Claude Code CLI, by kernel name or
# argv[0] (a shebang-script claude shows its own name as comm). Claude Code's
# installer keeps each release at <share>/claude/versions/<x.y.z>, and a session
# the `claude daemon` hosts (a background session) runs that versioned binary
# directly, so its comm and argv[0] are the version, not "claude". The wrapper
# around it (`claude bg-pty-host ... -- <session command>`) is named claude, so
# the nearest match going up from the hook must be the session, not the wrapper.
fcr_hook_is_claude() {
  local pid=$1 comm argv0 argv1=''
  read -r comm <"/proc/$pid/comm" 2>/dev/null || return 1
  [ "$comm" = claude ] && return 0
  { IFS= read -r -d '' argv0 && IFS= read -r -d '' argv1; } <"/proc/$pid/cmdline" 2>/dev/null || [ -n "${argv0:-}" ] || return 1
  [ "${argv0##*/}" = claude ] && return 0
  # argv1: the same binary run as a shebang script ("<interpreter> <path> ...").
  case "$argv0" in */claude/versions/[0-9]*) return 0 ;; esac
  case "$argv1" in */claude/versions/[0-9]*) return 0 ;; esac
  return 1
}

fcr_hook_ppid() {
  local stat
  local -a fields
  read -r stat <"/proc/$1/stat" 2>/dev/null || return 1
  # Field 2 (comm) may contain spaces and parentheses; everything after the
  # LAST ")" is well formed: "<state> <ppid> ...".
  read -r -a fields <<<"${stat##*) }"
  printf '%s' "${fields[1]:-}"
}

# fcr_hook_find_claude: print the pid of the nearest `claude` ancestor of this
# hook, or fail.
fcr_hook_find_claude() {
  local pid=$PPID depth=0
  while [ -n "$pid" ] && [ "$pid" -gt 1 ] && [ "$depth" -lt 64 ]; do
    if fcr_hook_is_claude "$pid"; then
      printf '%s' "$pid"
      return 0
    fi
    pid=$(fcr_hook_ppid "$pid") || break
    depth=$((depth + 1))
  done
  fcr_hook_debug "skip: no claude ancestor"
  return 1
}

# fcr_hook_home_root <dir>: print the nearest firstmate home root at or above
# <dir> (a directory holding bin/fm-lock.sh and bin/fm-spawn.sh), or fail.
fcr_hook_home_root() {
  local d=$1
  while [ -n "$d" ]; do
    if [ -f "$d/bin/fm-lock.sh" ] && [ -f "$d/bin/fm-spawn.sh" ]; then
      printf '%s' "$d"
      return 0
    fi
    [ "$d" != / ] || break
    d=${d%/*}
    [ -n "$d" ] || d=/
  done
  return 1
}

fcr_hook_main() {
  local input='' session_id cwd source transcript inbox state task_id target kind root
  local claude_pid argv_json env_rec env_json withheld_json herdr_session tmp now_iso now_epoch previous

  IFS= read -r -d '' -t 5 input || true
  [ -n "$input" ] || { fcr_hook_debug "skip: empty stdin"; return 0; }
  command -v jq >/dev/null 2>&1 || return 0

  session_id=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null) || return 0
  cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null) || return 0
  source=$(printf '%s' "$input" | jq -r '.source // empty' 2>/dev/null) || return 0
  transcript=$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null) || return 0
  [ -n "$session_id" ] || { fcr_hook_debug "skip: no session_id"; return 0; }
  [ -n "$cwd" ] || cwd=$PWD

  inbox=${FM_TASK_INBOX:-}
  if [ -n "$inbox" ]; then
    state=${inbox%/*}
    task_id=${inbox##*/}
    task_id=${task_id%.inbox}
    case "$inbox" in /*.inbox) ;; *) fcr_hook_debug "skip: malformed FM_TASK_INBOX=$inbox"; return 0 ;; esac
    if [ -z "$task_id" ] || [ ! -d "$state" ]; then fcr_hook_debug "skip: no state dir for $inbox"; return 0; fi
    target="$state/$task_id.claude-session"
    kind=task
    if root=$(fcr_hook_home_root "${cwd%/}") && [ "$root" != "${cwd%/}" ]; then
      fcr_hook_debug "cwd $cwd is inside the firstmate home $root; recording the home root"
      cwd=$root
    fi
  elif [ -f "$cwd/bin/fm-lock.sh" ] && [ -f "$cwd/bin/fm-spawn.sh" ]; then
    state="$cwd/state"
    task_id=''
    if [ ! -d "$state" ]; then
      (umask 022 && mkdir -p "$state") 2>/dev/null || return 0
    fi
    target="$state/.primary-claude-session"
    kind=primary
  else
    fcr_hook_debug "skip: not a firstmate session (cwd=$cwd)"
    return 0
  fi

  claude_pid=$(fcr_hook_find_claude) || return 0
  argv_json=$(jq -Rs '
    split("\u0000") | if .[-1] == "" then .[:-1] else . end
    # A shebang-script claude runs as "<interpreter> <path>/claude args...";
    # record the claude invocation itself.
    | if ((.[0] // "") | split("/") | last) != "claude" and ((.[1] // "") | split("/") | last) == "claude"
      then .[1:] else . end
    # A background session'"'"'s wrapper: `claude bg-pty-host ... -- <command...>`.
    # The command after "--" is the session itself.
    | if ((.[0] // "") | split("/") | last) == "claude" and .[1] == "bg-pty-host" and (index("--") != null)
      then .[(index("--") + 1):] else . end
    # A versioned binary (<share>/claude/versions/<x.y.z>), run directly or as a
    # script, becomes plain "claude", so the record survives a Claude update.
    | if ((.[0] // "") | test("/claude/versions/[0-9][^/]*$")) then .[0] = "claude"
      elif ((.[1] // "") | test("/claude/versions/[0-9][^/]*$")) and (((.[0] // "") | split("/") | last) | test("^(ba|da|z)?sh$|^env$"))
      then .[1:] | .[0] = "claude" else . end
  ' <"/proc/$claude_pid/cmdline" 2>/dev/null) || return 0
  if printf '%s' "$argv_json" | jq -e 'any(.[]; . == "-p" or . == "--print")' >/dev/null 2>&1; then
    fcr_hook_debug "skip: --print session $session_id"
    return 0
  fi
  if tr '\0' '\n' <"/proc/$claude_pid/environ" 2>/dev/null | grep -qx 'CLAUDECODE=1'; then
    fcr_hook_debug "skip: nested claude $claude_pid (CLAUDECODE=1 in its launch environment)"
    return 0
  fi
  # A malformed line in the extra file must not lose the whole environment:
  # fall back to the built-in pattern alone.
  env_rec=$(fcr_hook_env_json "$claude_pid" "$(fcr_hook_deny_pattern)") || {
    fcr_hook_debug "warn: bad pattern in the env deny file, using the built-in one"
    env_rec=$(fcr_hook_env_json "$claude_pid" "$FCR_ENV_DENY") || env_rec='{"env":{},"withheld":[]}'
  }
  env_json=$(printf '%s' "$env_rec" | jq -c '.env') || env_json='{}'
  withheld_json=$(printf '%s' "$env_rec" | jq -c '.withheld') || withheld_json='[]'

  herdr_session=${HERDR_SESSION:-}
  if [ -z "$herdr_session" ] && [ -n "${HERDR_SOCKET_PATH:-}" ]; then
    case "$HERDR_SOCKET_PATH" in
      */sessions/*/herdr.sock)
        herdr_session=${HERDR_SOCKET_PATH%/herdr.sock}
        herdr_session=${herdr_session##*/}
        ;;
      *) herdr_session=default ;;
    esac
  fi
  [ -n "$herdr_session" ] || [ -z "${HERDR_PANE_ID:-}" ] || herdr_session=default

  # Keep the ids this record named before, newest first, so a session that a
  # fresh start replaced (say, a primary reopened before `fcr resume` ran) can
  # still be resumed by hand.
  previous=$(jq -c --arg sid "$session_id" '
    (.previous_sessions // []) as $p
    | if .session_id != $sid
      then [{session_id, captured_at, source, transcript_path}] + $p else $p end
    | map(select(.session_id != $sid)) | .[:10]' "$target" 2>/dev/null) || previous='[]'
  printf '%s' "$previous" | jq -e 'type == "array"' >/dev/null 2>&1 || previous='[]'

  now_iso=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  now_epoch=$(date +%s)
  tmp="$state/.${target##*/}.tmp.$$"
  (
    umask 077
    jq -n \
      --arg kind "$kind" --arg task_id "$task_id" --arg state_dir "$state" \
      --arg session_id "$session_id" --arg source "$source" --arg cwd "$cwd" \
      --arg transcript "$transcript" --arg captured_at "$now_iso" --argjson captured_epoch "$now_epoch" \
      --arg hs "$herdr_session" --arg hw "${HERDR_WORKSPACE_ID:-}" \
      --arg ht "${HERDR_TAB_ID:-}" --arg hp "${HERDR_PANE_ID:-}" \
      --argjson claude_pid "$claude_pid" --argjson argv "$argv_json" --argjson env "$env_json" \
      --argjson withheld "$withheld_json" --argjson previous "$previous" '
      {
        format: 1, kind: $kind, task_id: $task_id, state_dir: $state_dir,
        session_id: $session_id, source: $source, cwd: $cwd, transcript_path: $transcript,
        captured_at: $captured_at, captured_epoch: $captured_epoch,
        herdr: {session: $hs, workspace_id: $hw, tab_id: $ht, pane_id: $hp},
        claude_pid: $claude_pid, argv: $argv, env: $env, env_scope: "full", env_withheld: $withheld,
        previous_sessions: $previous
      }' >"$tmp"
  ) 2>/dev/null || { rm -f "$tmp" 2>/dev/null; fcr_hook_debug "error: could not write $tmp"; return 0; }
  mv -f "$tmp" "$target" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; fcr_hook_debug "error: could not write $target"; return 0; }
  fcr_hook_debug "recorded $kind ${task_id:-primary} session=$session_id source=$source -> $target"
}

fcr_hook_main >/dev/null 2>&1 || true
exit 0
